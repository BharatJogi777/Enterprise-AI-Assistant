APP_NAME=Enterprise AI Assistant
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql://enterprise_ai:local_only_change_me@localhost:5434/enterprise_ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARACTERS=10000
API_KEY=replace-with-a-long-random-secret
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AGENT_MAX_STEPS=5
CONVERSATION_MEMORY_TURNS=12
ALLOWED_TOOLS=calculator,utc_time,search_internal_documents,search_web_tool
MCP_SERVERS_JSON=[]
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
