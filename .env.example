# Application
APP_NAME=Enterprise AI Assistant
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# API server
HOST=0.0.0.0
PORT=8000

# Ollama runs on the host for local development.
# When the API runs in Docker on macOS, host.docker.internal is usually appropriate.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL (values are examples for local development only)
DATABASE_URL=postgresql://assistant:assistant_dev_only@localhost:5432/enterprise_ai

# Limits (initial defaults; implementation will validate these)
MAX_REQUEST_SECONDS=60
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=4
MAX_RETRIEVED_CHUNKS=6
MAX_CONTEXT_CHARACTERS=12000

# Optional observability. Leave empty to disable until configured.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Web search provider is configured in a later phase.
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=
